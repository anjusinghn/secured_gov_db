generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model fsa_acc {
  detail_id          BigInt
  acc_pattern_onspot String?     @db.VarChar
  no_of_injuries     String?     @db.VarChar
  no_of_deaths       String?     @db.VarChar
  no_of_accidents    String?     @db.VarChar
  nearest_hosp       String?     @db.VarChar
  acc_id             String      @id(map: "acc_pkey") @db.VarChar
  start_age_range    Int?
  end_age_range      Int?
  age_range          String?     @db.VarChar
  time_frame_acc     String?     @db.VarChar
  edited             Boolean?    @default(false)
  created_at         DateTime    @default(now()) @db.Timestamptz(6)
  updated_at         DateTime    @default(now()) @db.Timestamptz(6)
  gen_details        gen_details @relation(fields: [detail_id], references: [detail_id], onDelete: NoAction, onUpdate: NoAction, map: "detail_id")

  @@index([detail_id], map: "idx_fsa_acc_detail_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model fsa_admin_table {
  /// @encrypted
  admin_email      String   @db.VarChar
  admin_email_hash String   @unique(map: "admin_email_hash_unique") @db.VarChar
  admin_id         BigInt   @id @default(autoincrement())
  admin_role_id    BigInt?
  admin_role       String?  @db.VarChar
  /// @encrypted
  admin_name       String?  @db.VarChar
  admin_pwd        String?  @db.VarChar
  login_status     Boolean?
  last_login       String?  @db.VarChar
  user_status      Boolean?
  /// @encrypted
  state_name       String?  @db.VarChar
  /// @encrypted
  district_name    String?  @db.VarChar
  state_code       String?  @db.VarChar
  district_code    String?  @db.VarChar
  /// @encrypted
  created_by       String?  @db.VarChar
  /// @encrypted
  phone_no         String?  @db.VarChar
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @default(now()) @db.Timestamptz(6)

  @@index([district_code], map: "idx_fsa_admin_district_code")
  @@index([state_code], map: "idx_fsa_admin_state_code")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model fsa_light {
  light_id        String      @id(map: "fsa_light_visib_pkey") @db.VarChar
  detail_id       BigInt
  light_avail     String?     @db.VarChar
  switch_type     String?     @db.VarChar
  non_avail_light String?     @db.VarChar
  light_photos    Json?
  edited          Boolean?    @default(false)
  delete_status   Boolean?
  created_at      DateTime    @default(now()) @db.Timestamptz(6)
  updated_at      DateTime    @default(now()) @db.Timestamptz(6)
  gen_details     gen_details @relation(fields: [detail_id], references: [detail_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([detail_id], map: "idx_fsa_light_detail_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model fsa_onspot {
  detail_id                 BigInt
  onspot_id                 String      @id @db.VarChar
  lat                       String?     @db.VarChar
